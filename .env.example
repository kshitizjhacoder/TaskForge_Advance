# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/taskforge?createDatabaseIfNotExist=true
DB_USERNAME=taskforge
DB_PASSWORD=change-me

# --- Security ---
# Signing key for JWTs: at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
# Frontend URL(s) allowed to call the API from a browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# First admin account, created at startup only if no admin exists yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-too

# --- Server ---
PORT=8080

# --- Added in later phases ---
# GEMINI_API_KEY=        (Phase 4: from Google AI Studio, no billing attached)
